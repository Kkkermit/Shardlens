{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:package": {
      "dependsOn": ["build"]
    },
    "api-report": {
      "dependsOn": ["build"]
    },
    "api-report:update": {
      "dependsOn": ["build"],
      "outputs": ["etc/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
