{
  "name": "@shardlens/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Shardlens documentation site (Astro Starlight).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node ../collector/dist/cli/openapi.js src/generated/openapi.json && node scripts/sdk-options.mjs",
    "dev": "pnpm generate && astro dev",
    "build": "pnpm generate && astro build",
    "preview": "astro preview",
    "typecheck": "tsc -p snippets/tsconfig.json && node scripts/check-prompt.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.12",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "^0.27.1",
    "starlight-typedoc": "^0.23.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@sapphire/framework": "^5.5.1",
    "@shardlens/collector": "workspace:*",
    "@shardlens/core": "workspace:*",
    "@shardlens/discordjs": "workspace:*",
    "@shardlens/exporter-otel": "workspace:*",
    "@shardlens/exporter-prometheus": "workspace:*",
    "@shardlens/http": "workspace:*",
    "@shardlens/schema": "workspace:*",
    "@types/node": "catalog:",
    "discord-api-types": "catalog:",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "catalog:",
    "prom-client": "^15.1.3",
    "typescript": "catalog:"
  }
}
