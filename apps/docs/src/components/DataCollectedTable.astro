---
// Rendered from @shardlens/schema's data-collected register at build time, so the docs can never drift from the
// wire format (a schema unit test fails if a field is missing from the register).
import data from '@shardlens/schema/collected-fields.json';

interface Props {
  /** Show privacy-mode fields, audit-only fields, or both. */
  mode?: 'privacy' | 'audit' | 'all';
}
const { mode = 'all' } = Astro.props;
type Field = { object: string; field: string; description: string; mode: string; personal: string; retention: string };
const fields = (data.fields as Field[]).filter((f) => mode === 'all' || f.mode === mode);
const groups = [...new Set(fields.map((f) => f.object))];
const retention = data.retention as Record<string, string>;
const personal: Record<string, string> = { no: 'No', pseudonymous: 'Pseudonymous', yes: 'Yes' };
---

{groups.map((group) => (
  <>
    <h3 id={`fields-${group}`}>
      <code>{group}</code>
    </h3>
    <table>
      <thead>
        <tr>
          <th>Field</th>
          <th>What it is</th>
          <th>Mode</th>
          <th>Personal data</th>
          <th>Kept</th>
        </tr>
      </thead>
      <tbody>
        {fields
          .filter((f) => f.object === group)
          .map((f) => (
            <tr>
              <td>
                <code>{f.field}</code>
              </td>
              <td>{f.description}</td>
              <td>{f.mode === 'audit' ? 'Audit only' : 'Both'}</td>
              <td>{personal[f.personal] ?? f.personal}</td>
              <td>{retention[f.retention] ?? f.retention}</td>
            </tr>
          ))}
      </tbody>
    </table>
  </>
))}
