---
/**
 * A button that copies a prompt for a coding agent, with the URL it is also served at. The prompt is in the page, so
 * copying needs no request.
 */
interface Props {
  /** The prompt, as Markdown. */
  prompt: string;
  /** Where the same prompt is served, relative to the site (`install.md`, `prompts/client.md`). */
  path: string;
  /** What the prompt sets up, for the button's accessible name: "Copy the prompt for <what>". */
  what: string;
}

const { prompt, path, what } = Astro.props;
// From the configured site, not `Astro.site`: pages are also rendered for llms-full.txt, where that isn't set.
const url = `${import.meta.env.SITE.replace(/\/$/, '')}${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
---

<div class="copy-prompt not-content">
  <button type="button" class="copy-prompt-button" data-copy-prompt aria-label={`Copy the prompt for ${what}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
      <path
        fill="currentColor"
        d="M16 2H8a3 3 0 0 0-3 3v1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1h1a3 3 0 0 0 3-3V6l-4-4Zm-2 18H4V8h1v9a3 3 0 0 0 3 3h6Zm4-5a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7v3h3v8Z"
      ></path>
    </svg>
    <span data-label>Copy for your AI agent</span>
  </button>
  <span class="copy-prompt-url">
    or point it at{' '}
    <a href={url}>
      <code>{url}</code>
    </a>
  </span>
  <template data-prompt>{prompt}</template>
  <span class="sr-only" role="status" aria-live="polite" data-status></span>
</div>

<script>
  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // No clipboard API (an insecure context, an old browser): copy through a selected text area.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const done = document.execCommand('copy');
      area.remove();
      return done;
    }
  };

  for (const box of document.querySelectorAll<HTMLElement>('.copy-prompt')) {
    const button = box.querySelector<HTMLButtonElement>('[data-copy-prompt]');
    const label = box.querySelector<HTMLElement>('[data-label]');
    const status = box.querySelector<HTMLElement>('[data-status]');
    const prompt = box.querySelector<HTMLTemplateElement>('template[data-prompt]')?.content.textContent ?? '';
    if (!button || !label || !status) continue;
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const done = await copy(prompt);
      label.textContent = done ? 'Copied: paste it to your agent' : 'Copy failed: open the link instead';
      status.textContent = done ? 'Prompt copied' : 'The prompt could not be copied';
      clearTimeout(reset);
      reset = setTimeout(() => {
        label.textContent = 'Copy for your AI agent';
        status.textContent = '';
      }, 3_000);
    });
  }
</script>

<style>
  .copy-prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-block: 1rem;
  }
  .copy-prompt-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 999rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .copy-prompt-button:hover {
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }
  .copy-prompt-button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .copy-prompt-url {
    min-width: 0;
    max-width: 100%;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .copy-prompt-url code {
    overflow-wrap: anywhere;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
