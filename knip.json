{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/load/*.js"],
      "ignoreDependencies": ["k6"]
    },
    "packages/*": {
      "entry": ["scripts/*.mjs", "bench/*.mjs"]
    },
    "apps/collector": {
      "entry": ["src/cli/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@shardlens/dashboard"],
      "ignoreExportsUsedInFile": { "interface": true }
    },
    "apps/dashboard": {
      "entry": ["e2e/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["scripts/*.mjs", "snippets/*.ts", "src/content/**/*.mdx"]
    },
    "examples/*": {
      "entry": ["src/*.ts"]
    },
    "tests/sim": {
      "entry": ["fake-discord/server.mjs", "fake-discord/preload.cjs"],
      "ignore": ["bots/**", "panel/**"]
    }
  }
}
