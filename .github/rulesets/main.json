{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "pnpm check", "integration_id": 15368 },
          { "context": "tests on Node 22", "integration_id": 15368 },
          { "context": "tests on Node 24", "integration_id": 15368 },
          { "context": "tests on Node 26", "integration_id": 15368 },
          { "context": "collector on PostgreSQL 16", "integration_id": 15368 },
          { "context": "collector on PostgreSQL 17", "integration_id": 15368 },
          { "context": "collector image builds", "integration_id": 15368 },
          { "context": "dashboard", "integration_id": 15368 },
          { "context": "build", "integration_id": 15368 },
          { "context": "CodeQL", "integration_id": 15368 },
          { "context": "Dependency review", "integration_id": 15368 },
          { "context": "Secret scan", "integration_id": 15368 }
        ]
      }
    }
  ]
}
