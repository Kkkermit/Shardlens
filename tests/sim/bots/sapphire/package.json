{
  "name": "sapphire-bot",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "description": "Community bot on the Sapphire framework, with settings in MongoDB.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=24.11" },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@sapphire/framework": "^5.5.1",
    "@shardlens/collector": "^1.0.0",
    "@shardlens/discordjs": "^1.0.0",
    "discord.js": "^14.28.1",
    "mongoose": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
