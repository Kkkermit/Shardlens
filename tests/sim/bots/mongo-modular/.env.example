# --- Discord ---
DISCORD_TOKEN=
# register slash commands to one server only while developing (instant updates)
DEV_GUILD_ID=
# sync slash commands on every start (true/false)
SYNC_COMMANDS=true
OWNER_IDS=

# --- MongoDB ---
MONGO_CONNECTION_STRING=mongodb://localhost:27017/nexus
# optional, overrides the database in the connection string
MONGO_DB_NAME=
MONGO_MAX_POOL_SIZE=10

# --- Bot ---
DEFAULT_PREFIX=!
PREFIX_CACHE_TTL_SECONDS=300

# --- Misc ---
NODE_ENV=production
LOG_LEVEL=info
