{
  "name": "ts-guide-bot",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Support-ticket bot built from the discord.js guide's layout.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=24.11" },
  "dependencies": {
    "@shardlens/discordjs": "^1.0.0",
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
