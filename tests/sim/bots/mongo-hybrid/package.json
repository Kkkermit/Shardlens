{
  "name": "helpdesk-bot",
  "version": "2.1.0",
  "private": true,
  "description": "Support desk bot: tickets, feedback and quotes, clustered with discord-hybrid-sharding.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "deploy": "node --env-file-if-exists=.env dist/deploy-commands.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "@shardlens/collector": "^1.3.0",
    "@shardlens/discordjs": "^1.3.0",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.28.1",
    "mongoose": "^9.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
