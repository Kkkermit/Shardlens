{
  "name": "sharded-bot",
  "version": "0.0.1",
  "private": true,
  "description": "discord.js ShardingManager with Shardlens running in each shard process.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/manager.ts",
    "start:internal": "node --env-file-if-exists=.env src/internal.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shardlens/discordjs": "workspace:*",
    "discord.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
