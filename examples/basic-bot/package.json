{
  "name": "basic-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal discord.js bot reporting to Shardlens (Guilds intent only).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "register": "node --env-file-if-exists=.env src/register.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shardlens/discordjs": "workspace:*",
    "discord.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
