{
  "name": "mongodb-bot",
  "version": "0.0.1",
  "private": true,
  "description": "A discord.js bot that keeps its Shardlens data in its own MongoDB, with nothing else to run.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "register": "node --env-file-if-exists=.env src/register.ts",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dashboard": "shardlens dashboard",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shardlens/collector": "workspace:*",
    "@shardlens/discordjs": "workspace:*",
    "discord.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "shardlens": "workspace:*",
    "typescript": "catalog:"
  }
}
