# Shardlens collector settings. Copy to .env and fill in. Never commit .env.
# Generate random values with:  openssl rand -base64 32

# Public hostname Caddy gets a certificate for, and the matching URL.
SHARDLENS_DOMAIN=stats.example.com
SHARDLENS_PUBLIC_URL=https://stats.example.com

# Your Discord application ID (Developer Portal → General Information).
SHARDLENS_APP_ID=

# Database password (any long random string).
POSTGRES_PASSWORD=

# 32+ random bytes each.
SHARDLENS_SESSION_SECRET=
SHARDLENS_SETTINGS_KEY=

# Keys: slk_ingest_ + 43 base64url characters for your bot, slk_read_ + 43 for the dashboard and scripts.
# Generate with:  node -e "console.log('slk_ingest_' + require('crypto').randomBytes(32).toString('base64url'))"
SHARDLENS_INGEST_KEY=
SHARDLENS_READ_KEY=

# Optional: "Sign in with Discord" for the dashboard (OAuth2 → Redirects: https://<domain>/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: user-install tracking via Discord webhook events (General Information → Public Key).
DISCORD_PUBLIC_KEY=

# Optional: comma-separated Discord user IDs allowed into the dashboard besides the app owner/team.
SHARDLENS_EXTRA_ADMINS=

# Audit mode only (32 random bytes, base64). Leave empty for privacy mode.
SHARDLENS_AUDIT_KEY=

# Public demo only: anyone can view the dashboard without signing in. Never set this on a collector with real data.
SHARDLENS_DEMO=false

LOG_LEVEL=info
