{
  "name": "@shardlens/discordjs",
  "version": "1.1.0",
  "description": "Shardlens adapter for discord.js: privacy-first product analytics and bot health in three lines.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kkkermit/Shardlens.git",
    "directory": "packages/discordjs"
  },
  "homepage": "https://github.com/Kkkermit/Shardlens#readme",
  "bugs": "https://github.com/Kkkermit/Shardlens/issues",
  "keywords": [
    "shardlens",
    "discord",
    "discord.js",
    "analytics",
    "bot",
    "metrics",
    "privacy"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "api-report": "api-extractor run",
    "api-report:update": "api-extractor run --local",
    "bench": "node --expose-gc bench/overhead.mjs"
  },
  "dependencies": {
    "@shardlens/core": "workspace:^"
  },
  "peerDependencies": {
    "discord.js": "^14.12.0 || ^15.0.0-0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@shardlens/schema": "workspace:*",
    "@types/node": "catalog:",
    "discord.js": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tinybench": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
