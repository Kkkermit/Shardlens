{
  "name": "@shardlens/schema",
  "version": "1.0.0",
  "description": "Shardlens wire format: zod schemas, a JSON Schema and TypeScript types for every event, with the metric registry and the register of collected data.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kkkermit/Shardlens.git",
    "directory": "packages/schema"
  },
  "homepage": "https://kkkermit.github.io/Shardlens/concepts/data-collected/",
  "bugs": "https://github.com/Kkkermit/Shardlens/issues",
  "keywords": [
    "shardlens",
    "discord",
    "discord.js",
    "analytics",
    "privacy",
    "schema",
    "json-schema",
    "zod"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./batch.schema.json": "./dist/batch.schema.json",
    "./metrics.json": "./dist/metrics.json",
    "./collected-fields.json": "./dist/collected-fields.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/emit-json.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints batch.schema.json metrics.json collected-fields.json",
    "api-report": "api-extractor run",
    "api-report:update": "api-extractor run --local"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "discord-api-types": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
