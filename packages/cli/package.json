{
  "name": "shardlens",
  "version": "1.0.0",
  "description": "Shardlens CLI: set up a self-hosted collector, generate keys, print a privacy-policy paragraph, check your setup.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kkkermit/Shardlens.git",
    "directory": "packages/cli"
  },
  "homepage": "https://kkkermit.github.io/Shardlens/reference/cli/",
  "bugs": "https://github.com/Kkkermit/Shardlens/issues",
  "keywords": [
    "shardlens",
    "discord",
    "discord.js",
    "discord-bot",
    "analytics",
    "privacy",
    "self-hosted",
    "docker-compose",
    "cli"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "shardlens": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-templates.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
